# =============================================================================
# CLEAN ROOM IMPLEMENTATION SYSTEM — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your API keys.
# Each zone uses a separate key to provide infrastructure-level isolation.
# The guard key is separate so it can never be reused in an analysis or
# implementation context by accident.

# Quarantine zone: Analysis Agent only
QUARANTINE_ZONE_API_KEY=sk-ant-...

# Guard agent: separate instance, fixed classification prompt
GUARD_API_KEY=sk-ant-...

# Implementation zone: Implementation Agent only
IMPL_ZONE_API_KEY=sk-ant-...

# =============================================================================
# Optional overrides — defaults are defined in config.py
# =============================================================================

# Model names (see Section 11.3 of the spec)
# ANALYSIS_MODEL=claude-sonnet-4-20250514
# GUARD_MODEL=claude-haiku-4-5-20251001
# IMPL_MODEL=claude-sonnet-4-20250514

# Spec store backend: "memory" (default, dev-only) or "s3" (production)
# SPEC_STORE_BACKEND=memory

# S3/DynamoDB config (only needed when SPEC_STORE_BACKEND=s3)
# SPEC_STORE_S3_BUCKET=my-cleanroom-specs
# SPEC_STORE_DYNAMO_TABLE=cleanroom-index

# Human review SLA in minutes (pipeline blocks on FLAG events until review)
# HUMAN_REVIEW_SLA_MINUTES=60
